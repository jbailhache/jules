<VirtualHost *:80>
    ServerName localhost
    DocumentRoot /data/cgicodif

    <Directory /data/cgicodif>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php/php8.6-fpm.sock|fcgi://localhost/"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/cgicodif_error.log
    CustomLog ${APACHE_LOG_DIR}/cgicodif_access.log combined
</VirtualHost>
